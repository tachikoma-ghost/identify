# Various IDEs and Editors
.vscode/
.idea/
**/*~

# Mac OSX temporary files
.DS_Store
**/.DS_Store

# generated files
# NOTE: src/declarations/backend/ is committed and regenerated via
# `npm run gen:declarations` (moc --idl + didc) now that dfx is gone. The
# agent-js subtree keeps its own generated declarations ignored.
src/frontend/agent-js/**/declarations/

# rust
target/

# frontend code
node_modules/
dist/
out/
tsconfig.tsbuildinfo
.svelte-kit/

# environment variables
.env

# mops and raw test data
.mops

# icp-cli cache (build artifacts). The data/mappings/ subdir holds
# committed canister-ID mappings and must NOT be ignored.
.icp/cache/

# temporary test files
/test/keys/20*

# release folder
release/

